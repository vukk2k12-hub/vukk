-- Toggle Helper (Giao diện chuẩn Bluesky)
local function createToggleButton(parent,text,y,settingKey,callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1,-10,0,32)
    btn.Position = UDim2.new(0,5,0,y)
    btn.BackgroundColor3 = Color3.fromRGB(28, 43, 60)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Text = text.." : "..(settings[settingKey] and "ON" or "OFF")
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)
    
    local tStroke = Instance.new("UIStroke", btn)
    tStroke.Color = Color3.fromRGB(135, 206, 250)
    tStroke.Thickness = 1
    tStroke.Transparency = settings[settingKey] and 0 or 0.5

    btn.MouseButton1Click:Connect(function()
        settings[settingKey] = not settings[settingKey]
        btn.Text = text.." : "..(settings[settingKey] and "ON" or "OFF")
        btn.TextColor3 = settings[settingKey] and Color3.fromRGB(135,206,250) or Color3.fromRGB(255,255,255)
        tStroke.Transparency = settings[settingKey] and 0 or 0.5
        callback(settings[settingKey])
    end)

    if settings[settingKey] then
        callback(true)
        btn.Text = text.." : ON"
        btn.TextColor3 = Color3.fromRGB(135,206,250)
    end
    return btn
end

