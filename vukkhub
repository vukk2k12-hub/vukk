task.spawn(function()
	while true do
		local hasAntiTp = "NO"
		local hasAntiSpeed = "NO"
		local hasAntiFly = "NO"

		for _, v in pairs(game:GetDescendants()) do
			if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then
				local name = string.lower(v.Name)
				if string.find(name, "anticheat") or string.find(name, "vanguard") or string.find(name, "grim") or string.find(name, "adonis") then
					hasAntiTp = "YES"
					hasAntiSpeed = "YES"
					hasAntiFly = "YES"
					break
				end
			end
		end

		if Workspace:FindFirstChild("AntiCheat") or Workspace:FindFirstChild("AntiExploit") then
			hasAntiTp = "YES"
			hasAntiSpeed = "YES"
		end
		
		if game:GetService("ReplicatedStorage"):FindFirstChild("AntiSpeed") or game:GetService("ReplicatedStorage"):FindFirstChild("CheckVelocity") then
			hasAntiSpeed = "YES"
			hasAntiFly = "YES"
		end

		antiTpLabel.Text = "• Anti TP: " .. (hasAntiTp == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
		antiSpeedLabel.Text = "• Anti Speed: " .. (hasAntiSpeed == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
		antiFlyLabel.Text = "• Anti Fly: " .. (hasAntiFly == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
		
		antiTpLabel.RichText = true
		antiSpeedLabel.RichText = true
		antiFlyLabel.RichText = true

		local detectedTeamMethod = "None / FFA"
		if #Teams:GetTeams() > 0 then
			if localPlayer.Team ~= nil then
				detectedTeamMethod = "Roblox Team Object"
			elseif localPlayer:FindFirstChild("TeamColor") or localPlayer:FindFirstChild("Team") then
				detectedTeamMethod = "TeamColor Parameter"
			else
				detectedTeamMethod = "Custom Folder Teams"
			end
		else
			local leaderstats = localPlayer:FindFirstChild("leaderstats")
			if leaderstats and (leaderstats:FindFirstChild("Team") or leaderstats:FindFirstChild("Faction") or leaderstats:FindFirstChild("Group")) then
				detectedTeamMethod = "Custom Leaderstats Value"
			elseif localPlayer.Character and (localPlayer.Character:FindFirstChild("Team") or localPlayer.Character:FindFirstChild("Group")) then
				detectedTeamMethod = "Custom Character Attributes"
			end
		end

		teamTypeLabel.Text = "• Active Method: <font color='rgb(0,255,255)'>" .. detectedTeamMethod .. "</font>"
		teamTypeLabel.RichText = true

		task.wait(2.5)
	end
end)

