local function createSettingInputRow(labelText, placeholder, defaultVal, posY, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.5, 0, 0, 25)
	label.Position = UDim2.new(0.05, 0, 0, posY)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Color3.fromRGB(240, 240, 240)
	label.TextSize = 11
	label.Font = Enum.Font.SourceSansBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = settingMainPanel

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.35, 0, 0, 22)
	box.Position = UDim2.new(0.55, 0, 0, posY + 1)
	box.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
	box.Text = tostring(defaultVal)
	box.PlaceholderText = placeholder
	box.TextColor3 = Color3.fromRGB(0, 255, 255)
	box.Font = Enum.Font.Code
	box.TextSize = 11
	box.Parent = settingMainPanel

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 5)
	boxCorner.Parent = box

	box.FocusLost:Connect(function()
		local num = tonumber(box.Text)
		if num then callback(num) else box.Text = tostring(defaultVal) end
	end)
end

