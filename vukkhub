local function isTeammate(targetPlayer)
	if not targetPlayer then return false end
	if localPlayer.Team and targetPlayer.Team then return localPlayer.Team == targetPlayer.Team end
	if localPlayer.TeamColor and targetPlayer.TeamColor then return localPlayer.TeamColor == targetPlayer.TeamColor end
	return false
end

local function checkIsFriend(targetPlayer)
	if friendMemory[targetPlayer.UserId] ~= nil then return friendMemory[targetPlayer.UserId] end
	local successCheck, isFriend = pcall(function() return localPlayer:IsFriendsWith(targetPlayer.UserId) end)
	if successCheck then friendMemory[targetPlayer.UserId] = isFriend return isFriend end
	return false
end

local function makeElementDraggable(guiObject)
	local dragging, dragInput, dragStart, startPos
	guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObject.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	guiObject.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

local function createCustomESPText(character, targetPlayer, showFriend)
	local head = character:WaitForChild("Head", 3)
	if not head then return end
	
	local billboard = head:FindFirstChild("CustomESP")
	if not billboard then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "CustomESP"
		billboard.Size = UDim2.new(0, 180, 0, 50)
		billboard.Adornee = head
		billboard.AlwaysOnTop = true
		billboard.ExtentsOffset = Vector3.new(0, 2.5, 0)
		billboard.Parent = head
		
		local label = Instance.new("TextLabel")
		label.Name = "InfoLabel"
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = textColorWhite 
		label.TextSize = 12
		label.Font = Enum.Font.SourceSansBold
		label.RichText = true
		
		local textStroke = Instance.new("UIStroke")
		textStroke.Thickness = 1
		textStroke.Color = Color3.fromRGB(0, 0, 0)
		textStroke.Parent = label
		
		label.Parent = billboard
	end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hpText = ""
	if humanoid then
		local hp = math.floor(humanoid.Health)
		local maxHp = math.floor(humanoid.MaxHealth)
		hpText = string.format("<br/><font color='rgb(255,255,255)'>[HP: %d/%d]</font>", hp, maxHp)
	end
	
	local friendText = showFriend and "<font color='rgb(255,255,255)'>[FRIEND]</font> " or ""
	billboard.InfoLabel.Text = friendText .. targetPlayer.DisplayName .. hpText
end

local function removeCustomESPText(character)
	if character and character:FindFirstChild("Head") and character.Head:FindFirstChild("CustomESP") then
		character.Head.CustomESP:Destroy()
	end
end

