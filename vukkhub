	tabBtn.ZIndex = 5
	tabBtn.Parent = leftTabBar
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = tabBtn
	
	buttonContainers[tabId] = {}
	tabCustomContainers[tabId] = {}

	tabBtn.MouseButton1Click:Connect(function()
		currentTab = tabId
		for _, child in pairs(leftTabBar:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundTransparency = 0.85
			end
		end
		tabBtn.BackgroundTransparency = 0.4

		if currentTab == "Hacker" or currentTab == "Setting" then
			gridLayout.Enabled = false
		else
			gridLayout.Enabled = true
		end

		for tId, btnList in pairs(buttonContainers) do
			for _, btn in pairs(btnList) do btn.Visible = (tId == currentTab) end
		end
		for tId, panelList in pairs(tabCustomContainers) do
			for _, panel in pairs(panelList) do panel.Visible = (tId == currentTab) end
		end
		
		if currentTab == "Scripts" then
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 500)
		elseif currentTab == "Hacker" or currentTab == "Setting" then
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 400)
		else
			task.skip()
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + 30)
		end
	end)
end

