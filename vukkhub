local function createTab(tabId, text, isDefault)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(0.9, 0, 0, 32)
	tabBtn.BackgroundColor3 = colorSky
	tabBtn.BackgroundTransparency = isDefault and 0.4 or 0.85
	tabBtn.Text = text
	tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	tabBtn.Font = Enum.Font.SourceSansBold
	tabBtn.TextSize = 13
	tabBtn.ZIndex = 5
	tabBtn.Parent = leftTabBar
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = tabBtn

	-- Tạo một ScrollingFrame riêng biệt cho từng Tab để cô lập layout
	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 0.85
	page.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	page.BorderSizePixel = 0
	page.Visible = isDefault
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.ScrollBarThickness = 4
	page.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
	page.Parent = containerFrame

	local pCorner = Instance.new("UICorner")
	pCorner.CornerRadius = UDim.new(0, 10)
	pCorner.Parent = page

	tabsMemory[tabId] = {Button = tabBtn, Page = page}

	-- Thiết lập layout dạng Grid cho các tab thông thường
	if tabId ~= "Hacker" and tabId ~= "Setting" then
		local gridLayout = Instance.new("UIGridLayout")
		gridLayout.CellSize = UDim2.new(0, 85, 0, 35) -- Giữ nguyên nút nhỏ 85x35
		gridLayout.CellPadding = UDim2.new(0, 10, 0, 10)
		gridLayout.Parent = page

		local scrollPadding = Instance.new("UIPadding")
		scrollPadding.PaddingTop = UDim.new(0, 10)
		scrollPadding.PaddingLeft = UDim.new(0, 10)
		scrollPadding.Parent = page
		
		-- Tự động cập nhật vùng cuộn dựa trên số phần tử bên trong
		gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + 25)
		end)
	else
		-- Layout List dành riêng cho tab Custom
		local listLayout = Instance.new("UIListLayout")
		listLayout.Padding = UDim.new(0, 10)
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		listLayout.Parent = page

		local scrollPadding = Instance.new("UIPadding")
		scrollPadding.PaddingTop = UDim.new(0, 10)
		scrollPadding.Parent = page

		listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			page.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 25)
		end)
	end

	tabBtn.MouseButton1Click:Connect(function()
		currentTab = tabId
		for _, data in pairs(tabsMemory) do
			data.Button.BackgroundTransparency = 0.85
			data.Page.Visible = false
		end
		tabBtn.BackgroundTransparency = 0.4
		page.Visible = true
	end)
end

