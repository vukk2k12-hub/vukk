local function createTabButton(tabId, text, isDefault)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(0.9, 0, 0, 35)
	tabBtn.BackgroundColor3 = borderLightColor
	tabBtn.BackgroundTransparency = isDefault and 0.4 or 0.85
