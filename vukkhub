local function updateESPAndHitboxForPlayer(player)
	if player == localPlayer then return end
	
	local function onCharAdded(character)
		local hrp = character:WaitForChild("HumanoidRootPart", 5)
		local hum = character:WaitForChild("Humanoid", 5)
		if not hrp or not hum then return end

		local hpConnection
		hpConnection = hum.HealthChanged:Connect(function()
			if character.Parent and hrp:FindFirstChild("ESPHighlight") then
				local isFriend = checkIsFriend(player)
				createCustomESPText(character, player, states.CheckFriends and isFriend)
			else
				hpConnection:Disconnect()
			end
		end)

		local isTeam = isTeammate(player)
		local isFriend = checkIsFriend(player)
		local ignoreThisPlayer = states.AntiFriend and isFriend

		local targetVisualColor = (isTeam or isFriend) and colorGreen or colorSky

		-- ESP Box
		local shouldESP = (states.ESPAll or (states.ESPTeam and isTeam)) and not ignoreThisPlayer
		if shouldESP then
			local highlight = hrp:FindFirstChild("ESPHighlight") or Instance.new("Highlight")
			highlight.Name = "ESPHighlight"
			highlight.Adornee = character
			highlight.Parent = hrp
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0
			highlight.OutlineColor = targetVisualColor 
			
			createCustomESPText(character, player, states.CheckFriends and isFriend)
		else
			local highlight = hrp:FindFirstChild("ESPHighlight")
			if highlight then highlight:Destroy() end
			removeCustomESPText(character)
		end

		-- Hitbox
		local shouldHitbox = (states.HitboxAll or (states.HitboxTeam and isTeam)) and not ignoreThisPlayer
		if shouldHitbox then
			if not hitboxMemory[player] then
				hitboxMemory[player] = {Size = hrp.Size, Trans = hrp.Transparency, Collide = hrp.CanCollide, Color = hrp.Color}
			end
			hrp.Size = Vector3.new(settingsConfig.HitboxSizeValue, settingsConfig.HitboxSizeValue, settingsConfig.HitboxSizeValue)
			hrp.CanCollide = false
			hrp.Transparency = settingsConfig.HitboxTransValue
			hrp.Color = targetVisualColor 
		else
			if hitboxMemory[player] then
				hrp.Size = hitboxMemory[player].Size
				hrp.Transparency = hitboxMemory[player].Trans
				hrp.CanCollide = hitboxMemory[player].Collide
				hrp.Color = hitboxMemory[player].Color
				hitboxMemory[player] = nil
			end
		end
	end

	if player.Character then task.spawn(onCharAdded, player.Character) end
	player.CharacterAdded:Connect(onCharAdded)
end

local function triggerESPRefresh()
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then updateESPAndHitboxForPlayer(p) end
	end
end

Players.PlayerAdded:Connect(function(newPlayer)
	updateESPAndHitboxForPlayer(newPlayer)
