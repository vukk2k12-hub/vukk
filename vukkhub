local function createTabButton(tabId, text, isDefault)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Size = UDim2.new(0.9, 0, 0, 35)
	tabBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	tabBtn.BackgroundTransparency = isDefault and 0.5 or 0.9
	tabBtn.Text = text
	tabBtn.TextColor3 = isDefault and Color3.fromRGB(22, 45, 90) or Color3.fromRGB(255, 255, 255)
	tabBtn.Font = Enum.Font.SourceSansBold
	tabBtn.TextSize = 13
	tabBtn.ZIndex = 5
	tabBtn.Parent = leftTabBar
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = tabBtn
	
	buttonContainers[tabId] = {}
	tabCustomContainers[tabId] = {}

	tabBtn.MouseButton1Click:Connect(function()
		currentTab = tabId
		for _, child in pairs(leftTabBar:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundTransparency = 0.9
				child.TextColor3 = Color3.fromRGB(255, 255, 255)
			end
		end
		tabBtn.BackgroundTransparency = 0.5
		tabBtn.TextColor3 = Color3.fromRGB(22, 45, 90)

		if currentTab == "Hacker" or currentTab == "Setting" then
			gridLayout.Enabled = false
		else
			gridLayout.Enabled = true
		end

		for tId, btnList in pairs(buttonContainers) do
			for _, btn in pairs(btnList) do btn.Visible = (tId == currentTab) end
		end
		
		for tId, panelList in pairs(tabCustomContainers) do
			for _, panel in pairs(panelList) do panel.Visible = (tId == currentTab) end
		end
		
		if currentTab == "Scripts" then
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 1000)
		elseif currentTab == "Hacker" or currentTab == "Setting" then
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 550)
		else
			rightScrollFrame.CanvasSize = UDim2.new(0, 0, 0, gridLayout.AbsoluteContentSize.Y + 24)
		end
	end)
end

