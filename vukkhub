	cloud.Parent = cloudContainer

	local cloudCorner = Instance.new("UICorner")
	cloudCorner.CornerRadius = UDim.new(0.5, 0)
	cloudCorner.Parent = cloud

	task.spawn(function()
		while true do
			cloud.Position = UDim2.new(-0.3, 0, startY, 0)
			local moveTween = TweenService:Create(cloud, TweenInfo.new(speed, Enum.EasingStyle.Linear), {Position = UDim2.new(1.2, 0, startY, 0)})
			moveTween:Play()
			moveTween.Completed:Wait()
		end
	end)
end
