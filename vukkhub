local function createCloud(size, startY, speed)
	local cloud = Instance.new("Frame")
	cloud.Size = size
	cloud.Position = UDim2.new(-0.3, 0, startY, 0)
	cloud.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
