				if v:IsA("Script") or v:IsA("LocalScript") then
					local name = string.lower(v.Name)
					if string.find(name, "anticheat") or string.find(name, "vanguard") or string.find(name, "adonis") then
						hasAntiTp, hasAntiSpeed, hasAntiFly = "YES", "YES", "YES" break
					end
				end
			end
			antiTpLabel.Text = "• Anti TP: " .. (hasAntiTp == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
			antiSpeedLabel.Text = "• Anti Speed: " .. (hasAntiSpeed == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
			antiFlyLabel.Text = "• Anti Fly: " .. (hasAntiFly == "YES" and "<font color='rgb(255,0,0)'>YES</font>" or "<font color='rgb(0,255,0)'>NO</font>")
			antiTpLabel.RichText, antiSpeedLabel.RichText, antiFlyLabel.RichText = true, true, true

			local detMethod = "None / FFA"
			if #Teams:GetTeams() > 0 then detMethod = "Roblox Team Object"
			elseif localPlayer:FindFirstChild("leaderstats") then detMethod = "Leaderstats Team" end
			teamTypeLabel.Text = "• Active Method: <font color='rgb(0,255,255)'>" .. detMethod .. "</font>"
			teamTypeLabel.RichText = true
		end
		task.wait(2.5)
	end
end)

