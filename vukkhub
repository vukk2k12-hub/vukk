-- Main loop cập nhật ESP và Hitbox REALTIME mỗi frame
rs.RenderStepped:Connect(function()
    for _, p in pairs(game.Players:GetPlayers()) do
        -- Hitbox
        if settings.HitboxAll or settings.HitboxTeam then 
            applyHitboxReal(p, settings.HitboxTeam) 
        else 
            resetHitboxReal(p) 
        end
        
        -- ESP
        if settings.ESPAll or settings.ESPTeam then 
            applyESP(p, settings.ESPTeam) 
        else 
            resetESP(p) 
        end
    end
end)

