-- --- TAB 2: BOX ESP HÌNH CHỮ NHẬT & THANH MÁU HP ---
task.spawn(function()
	while true do
		if states.ESPAll or states.ESPTeam or states.HitboxAll or states.HitboxTeam then
			for _, player in pairs(Players:GetPlayers()) do
				if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local hrp = player.Character.HumanoidRootPart
					local isTeam = isTeammate(player)
					local isFriend = checkIsFriend(player)
					local ignoreThisPlayer = states.AntiFriend and isFriend

					-- Render Box ESP & HP text
					local shouldESP = (states.ESPAll or (states.ESPTeam and isTeam)) and not ignoreThisPlayer
					if shouldESP then
						local highlight = hrp:FindFirstChild("ESPHighlight") or Instance.new("Highlight")
						highlight.Name = "ESPHighlight"
						highlight.Adornee = player.Character
						highlight.Parent = hrp
						
						highlight.FillTransparency = 1 
						highlight.OutlineTransparency = 0
						
						if states.CheckFriends and isFriend then
							highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
							createCustomESPText(player.Character, player, true)
						else
							highlight.OutlineColor = isTeam and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(255, 0, 0)
							createCustomESPText(player.Character, player, false)
						end
					else
						local highlight = hrp:FindFirstChild("ESPHighlight")
						if highlight then highlight:Destroy() end
						removeCustomESPText(player.Character)
					end

					-- Render Hitbox nâng cao theo cấu hình tại Tab 5
					local shouldHitbox = (states.HitboxAll or (states.HitboxTeam and isTeam)) and not ignoreThisPlayer
					if shouldHitbox then
						if not hitboxMemory[player] then
							hitboxMemory[player] = {Size = hrp.Size, Trans = hrp.Transparency, Collide = hrp.CanCollide, Color = hrp.Color}
						end
						hrp.Size = Vector3.new(settingsConfig.HitboxSizeValue, settingsConfig.HitboxSizeValue, settingsConfig.HitboxSizeValue)
						hrp.CanCollide = false
						hrp.Transparency = settingsConfig.HitboxTransValue
						
						if states.CheckFriends and isFriend then
							hrp.Color = Color3.fromRGB(0, 255, 0)
						else
							hrp.Color = isTeam and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(255, 0, 0)
						end
					else
						if hitboxMemory[player] then
							hrp.Size = hitboxMemory[player].Size
							hrp.Transparency = hitboxMemory[player].Trans
							hrp.CanCollide = hitboxMemory[player].Collide
							hrp.Color = hitboxMemory[player].Color
							hitboxMemory[player] = nil
						end
					end
				end
			end
		else
			for _, player in pairs(Players:GetPlayers()) do
				if player.Character then
					if player.Character:FindFirstChild("HumanoidRootPart") then
						local hl = player.Character.HumanoidRootPart:FindFirstChild("ESPHighlight")
						if hl then hl:Destroy() end
						local hrp = player.Character.HumanoidRootPart
						if hitboxMemory[player] then
							hrp.Size = hitboxMemory[player].Size
							hrp.Transparency = hitboxMemory[player].Trans
							hrp.CanCollide = hitboxMemory[player].Collide
							hrp.Color = hitboxMemory[player].Color
						end
					end
					removeCustomESPText(player.Character)
				end
			end
			table.clear(hitboxMemory)
		end
		task.wait(0.2)
	end
end)

