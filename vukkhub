rs.Heartbeat:Connect(function()
    for _, p in pairs(players:GetPlayers()) do
        if p ~= player then
            updatePlayerTeamStatus(p)
            if p.Character then
                if settings.HitboxAll then applyHitboxReal(p, false)
                elseif settings.HitboxTeam then applyHitboxReal(p, true)
                else resetHitboxReal(p) end
                if settings.ESPAll then applyESP(p, false)
                elseif settings.ESPTeam then applyESP(p, true)
                elseif settings.ESPFriend and player:IsFriendsWith(p.UserId) then applyESP(p, false)
                else resetESP(p) end
            end
        end
    end
end)

