local function addMonitorLog(text)
	if monitorPaused then return end
	if #monitoredLogs >= maxLogs then
		table.remove(monitoredLogs, 1)
		local first = logScroll:GetChildren()[2]
		if first and first:IsA("TextBox") then first:Destroy() end
	end
	table.insert(monitoredLogs, text)
	
	local logBox = Instance.new("TextBox")
	logBox.Size = UDim2.new(1, -6, 0, 16)
	logBox.BackgroundTransparency = 1
	logBox.Text = text
	logBox.ClearTextOnFocus = false
	logBox.TextEditable = false
	logBox.TextColor3 = colorSky
	logBox.Font = Enum.Font.Code
	logBox.TextSize = 9
	logBox.TextXAlignment = Enum.TextXAlignment.Left
	logBox.Parent = logScroll
end

local rawMeta = getrawmetatable(game)
if rawMeta and make_writeable then
	setreadonly(rawMeta, false)
	local oldNamecall = rawMeta.__namecall
	rawMeta.__namecall = newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if (method == "FireServer" or method == "InvokeServer") and not monitorPaused then
			task.spawn(function()
				addMonitorLog("[" .. method .. "] -> " .. self.Name)
			end)
		end
		return oldNamecall(self, ...)
	end)
	setreadonly(rawMeta, true)
else
	LogService.MessageDrivenChannelFromString:Connect(function(msg)
		if string.find(string.lower(msg), "remote") or string.find(string.lower(msg), "fire") then
			addMonitorLog("[Event]: " .. msg)
		end
	end)
end

