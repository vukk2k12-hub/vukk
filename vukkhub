-- ==========================================
-- Định nghĩa danh sách các sắc độ màu sắc phát sáng Blue Sky chạy tuần hoàn liên tục
local glowColors = {
	Color3.fromRGB(135, 206, 250), -- Sky Blue sáng nguyên bản
	Color3.fromRGB(30, 144, 255),  -- Dodger Blue (Màu xanh biển sâu đậm)
	Color3.fromRGB(0, 191, 255),   -- Deep Sky Blue rực rỡ
	Color3.fromRGB(0, 255, 255),   -- Cyan/Aqua Neon phát sáng cực mạnh
	Color3.fromRGB(65, 105, 225)   -- Royal Blue tinh tế
}

task.spawn(function()
	local colorIndex = 1
	while true do
		local nextColor = glowColors[colorIndex]
		
		-- Tạo Tween chuyển màu mượt mà đồng bộ cho cả viền menu chính và viền nút bấm trong 1 giây
		local tweenInfo = TweenInfo.new(1.0, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
		local tweenMenu = TweenService:Create(menuStroke, tweenInfo, {Color = nextColor})
		local tweenButton = TweenService:Create(btnStroke, tweenInfo, {Color = nextColor})
		
		tweenMenu:Play()
		tweenButton:Play()
		
		-- Đợi tween hoàn tất rồi nhảy sang mã màu tiếp theo trong danh sách tuần hoàn
		tweenMenu.Completed:Wait()
		colorIndex = (colorIndex % #glowColors) + 1
	end
end)

