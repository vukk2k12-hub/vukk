local function createCheatButton(tabId, name, displayName, callback)
	local btn = Instance.new("TextButton")
	btn.Text = displayName
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 13
	btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	btn.BackgroundTransparency = 0.85
	btn.ZIndex = 5
	btn.Visible = (tabId == currentTab)
	btn.Parent = rightScrollFrame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn
	
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.5
	stroke.Parent = btn

	table.insert(buttonContainers[tabId], btn)

	btn.MouseButton1Click:Connect(function()
		states[name] = not states[name]
		if states[name] then
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3, BackgroundColor3 = Color3.fromRGB(0, 255, 127)}):Play()
			btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		else
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.85, BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		callback(states[name])
	end)
end

