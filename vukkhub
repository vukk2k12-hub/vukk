-- HÀM QUÉT ĐỒNG THỜI CẢ TEAM & ANTI-CHEAT
-- =========================================================
local function MasterScanner()
    ---------------- KHU VỰC QUÉT TEAM ----------------
    local detects = { Auto = false, Spawn = false, UI = false, Random = false, Balanced = false, Gated = false, Attr = false, Tag = false, Money = false }
    for _, t in pairs(teams:GetTeams()) do
        if t.AutoAssignable then detects.Auto = true end
        if string.find(string.lower(t.Name), "vip") or string.find(string.lower(t.Name), "pass") then detects.Money = true end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.AllowTeamChangeOnTouch then detects.Spawn = true break end
    end
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        for _, gui in pairs(pGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local n, t = string.lower(gui.Name), string.lower(gui:IsA("TextButton") and gui.Text or "")
                if string.find(n, "team") or string.find(t, "choose") or string.find(t, "select") then detects.UI = true break end
            end
        end
    end
    for _, p in pairs(players:GetPlayers()) do
        if p:GetAttribute("Team") or p:GetAttribute("Role") then detects.Attr = true end
        if #collectionService:GetTags(p) > 0 then detects.Tag = true end
        if p:FindFirstChild("leaderstats") and (p.leaderstats:FindFirstChild("Level") or p.leaderstats:FindFirstChild("Rank")) then detects.Gated = true end
    end
    local allTeams = teams:GetTeams()
    if #allTeams > 1 then
        local counts = {} for _, t in pairs(allTeams) do table.insert(counts, #t:GetPlayers()) end
        table.sort(counts)
        if counts[#counts] - counts[1] <= 1 and #players:GetPlayers() > 2 then detects.Balanced = true else detects.Random = true end
    end
    for key, state in pairs(detects) do
        local labelData = teamLabels[key]
        if labelData then
            if state then labelData.obj.Text = "• " .. labelData.text .. ":  Yes" labelData.obj.TextColor3 = Color3.fromRGB(0, 255, 128)
            else labelData.obj.Text = "• " .. labelData.text .. ": ❌ No" labelData.obj.TextColor3 = Color3.fromRGB(180, 180, 180) end
        end
    end

    -------------- KHU VỰC QUÉT ANTI-CHEAT --------------
    local antis = { Adonis = false, Valkyrie = false, Memory = false, Humanoid = false, Remote = false, Byfron = true } -- Byfron mặc định 2026 luôn bật ở client gốc Roblox

    -- 1. Tìm kiếm Core Script ngầm (Adonis / Valkyrie) trong ReplicatedStorage và các vị trí lưu trữ công cộng
    for _, item in pairs(game:GetDescendants()) do
        if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
            local name = string.lower(item.Name)
            if string.find(name, "adonis") or string.find(name, "loader") then antis.Adonis = true end
            if string.find(name, "vanguard") or string.find(name, "valk") or string.find(name, "ac") then antis.Valkyrie = true end
            if string.find(name, "check") or string.find(name, "detect") then antis.Remote = true end
        end
    end

    -- 2. Kiểm tra giám sát thay đổi thuộc tính cục bộ (Humanoid State)
    if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        -- Nếu game khóa hoặc liên tục gán giá trị ép WalkSpeed về gốc => Có check Memory / Humanoid
        if hum.WalkSpeed == 16 and settings.SpeedToggle and settings.Speed > 30 then
            antis.Memory = true
        end
    end

    -- Hiển thị kết quả lên giao diện bảng Anti-Cheat
    for key, state in pairs(antis) do
        local labelData = antiLabels[key]
        if labelData then
            if state then
                labelData.obj.Text = "• " .. labelData.text .. ": ⚠️ Yes (Phát hiện)"
                labelData.obj.TextColor3 = Color3.fromRGB(255, 75, 75) -- Đỏ rực cảnh báo nguy hiểm
            else
                labelData.obj.Text = "• " .. labelData.text .. ": 安全 Safe"
                labelData.obj.TextColor3 = Color3.fromRGB(150, 200, 150) -- Xanh an toàn
            end
        end
    end
end

