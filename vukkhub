-- ==========================================
-- 6. ĐỒNG BỘ ĐỔI MÀU & HIỆU ỨNG BỒNG BỀNH
-- ==========================================
task.spawn(function()
	while true do
		local t1 = TweenService:Create(mainMenu, colorTweenInfo, {BackgroundColor3 = colorDark})
		local t2 = TweenService:Create(menuButton, colorTweenInfo, {BackgroundColor3 = colorDark})
		local t3 = TweenService:Create(btnStroke, colorTweenInfo, {Color = colorLight})
		t1:Play() t2:Play() t3:Play() t1.Completed:Wait()
		
		local t4 = TweenService:Create(mainMenu, colorTweenInfo, {BackgroundColor3 = colorLight})
		local t5 = TweenService:Create(menuButton, colorTweenInfo, {BackgroundColor3 = colorLight})
		local t6 = TweenService:Create(btnStroke, colorTweenInfo, {Color = colorDark})
		t4:Play() t5:Play() t6:Play() t4.Completed:Wait()
	end
end)

local isMenuOpen = false
local basePosition = UDim2.new(0.5, 0, 0.5, 0)
local bobbingConnection

local function startBobbing()
	if bobbingConnection then bobbingConnection:Disconnect() end
	local startTime = os.clock()
	bobbingConnection = RunService.RenderStepped:Connect(function()
		if isMenuOpen then
			local offset = math.sin((os.clock() - startTime) * 2) * 12
			mainMenu.Position = UDim2.new(0.5, 0, 0.5, offset)
		end
	end)
end

local function stopBobbing()
	if bobbingConnection then bobbingConnection:Disconnect() bobbingConnection = nil end
end

-- Thao tác click Bật/Tắt
menuButton.MouseButton1Click:Connect(function()
	isMenuOpen = not isMenuOpen
	
	-- Hiệu ứng co giãn nút vuông khi nhấn
	TweenService:Create(menuButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 52, 0, 52)}):Play()
	task.delay(0.1, function()
		TweenService:Create(menuButton, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 60, 0, 60)}):Play()
	end)
	
	if isMenuOpen then
		mainMenu.Size = UDim2.new(0, 0, 0, 0)
		mainMenu.Position = basePosition
		mainMenu.Visible = true
		
		local menuTween = TweenService:Create(mainMenu, popTweenInfo, {Size = UDim2.new(0.65, 0, 0.7, 0)})
		menuTween:Play()
		menuTween.Completed:Connect(function()
			if isMenuOpen then startBobbing() end
		end)
	else
		stopBobbing()
		local menuTween = TweenService:Create(mainMenu, fadeTweenInfo, {Size = UDim2.new(0, 0, 0, 0), Position = basePosition})
		menuTween:Play()
		menuTween.Completed:Connect(function()
			if not isMenuOpen then mainMenu.Visible = false end
		end)
	end
end)
