-- 4. HỆ THỐNG MÂY TRÔI (BACKGROUND)
-- ==========================================
local cloudContainer = Instance.new("Frame")
cloudContainer.Size = UDim2.new(1, 0, 1, 0)
cloudContainer.BackgroundTransparency = 1
cloudContainer.ZIndex = 2
cloudContainer.Parent = mainMenu

local function createCloud(size, startY, speed)
	local cloud = Instance.new("Frame")
	cloud.Size = size
	cloud.Position = UDim2.new(-0.3, 0, startY, 0)
	cloud.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	cloud.BackgroundTransparency = 0.65
	cloud.BorderSizePixel = 0
	cloud.ZIndex = 2
	cloud.Parent = cloudContainer

	local cloudCorner = Instance.new("UICorner")
	cloudCorner.CornerRadius = UDim.new(0.5, 0)
	cloudCorner.Parent = cloud

	task.spawn(function()
		while true do
			cloud.Position = UDim2.new(-0.3, 0, startY, 0)
			local moveTween = TweenService:Create(cloud, TweenInfo.new(speed, Enum.EasingStyle.Linear), {
				Position = UDim2.new(1.2, 0, startY, 0)
			})
			moveTween:Play()
			moveTween.Completed:Wait()
		end
	end)
end

createCloud(UDim2.new(0, 180, 0, 60), 0.1, 20)
createCloud(UDim2.new(0, 250, 0, 80), 0.4, 28)

