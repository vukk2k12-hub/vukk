-- Dictionary lưu các hitbox của player
local playerHitboxes = {}
local playerTeams = {} -- Lưu team hiện tại của mỗi player

local function shouldTargetPlayer(p, teamCheck)
    if p == player then return false end
    if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    if teamCheck then
        return p.Team ~= player.Team
    end
    return true
end

local function applyHitboxReal(p, teamCheck)
    if not shouldTargetPlayer(p, teamCheck) then return end

    local hrp = p.Character.HumanoidRootPart
    hrp.Size = Vector3.new(settings.HitboxSize, settings.HitboxSize, settings.HitboxSize)
    hrp.Transparency = settings.HitboxTransparency
    hrp.Material = Enum.Material.Neon
    hrp.Color = Color3.fromRGB(135,206,235)
    
    -- Lưu vào dictionary
    playerHitboxes[p.UserId] = hrp
    playerTeams[p.UserId] = p.Team
end

local function resetHitboxReal(p)
    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = p.Character.HumanoidRootPart
        hrp.Size = Vector3.new(2,2,1)
        hrp.Transparency = 1
    end
    playerHitboxes[p.UserId] = nil
    playerTeams[p.UserId] = nil
end

-- Update hitbox properties realtime (Size, Transparency)
rs.RenderStepped:Connect(function()
    for userId, hrp in pairs(playerHitboxes) do
        if hrp and hrp.Parent then
            hrp.Size = Vector3.new(settings.HitboxSize, settings.HitboxSize, settings.HitboxSize)
            hrp.Transparency = settings.HitboxTransparency
        else
            playerHitboxes[userId] = nil
            playerTeams[userId] = nil
        end
    end
end)

local function getHealthColor(hp)
    if hp >= 80 then
        return Color3.fromRGB(0, 255, 0)
    elseif hp > 30 then
        return Color3.fromRGB(255, 255, 0)
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

local function createHealthBar(p)
    if p == player or not p.Character or p.Character:FindFirstChild("BaconHealthBar") then return end
    
    local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Name = "BaconHealthBar"
    billboardGui.Size = UDim2.new(8, 0, 1, 0)
    billboardGui.StudsOffset = Vector3.new(0, 5, 0)
    billboardGui.MaxDistance = math.huge
    billboardGui.Adornee = p.Character:FindFirstChild("HumanoidRootPart")
    billboardGui.Parent = p.Character
    
    local container = Instance.new("Frame", billboardGui)
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 0.3
    container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
    
    local healthBar = Instance.new("Frame", container)
    healthBar.Name = "HealthBar"
    healthBar.Size = UDim2.new(1, -4, 1, -4)
    healthBar.Position = UDim2.new(0, 2, 0, 2)
    healthBar.BackgroundColor3 = getHealthColor(humanoid.Health)
    Instance.new("UICorner", healthBar).CornerRadius = UDim.new(0, 4)
    
    local function updateHealth(newHealth)
        local maxHealth = humanoid.MaxHealth
        local ratio = math.max(0, math.min(1, newHealth / maxHealth))
        
        healthBar.Size = UDim2.new(ratio, -4, 1, -4)
        healthBar.BackgroundColor3 = getHealthColor(newHealth)
    end
    
    updateHealth(humanoid.Health)
    humanoid.HealthChanged:Connect(updateHealth)
    
    humanoid.Died:Connect(function()
        if billboardGui then billboardGui:Destroy() end
    end)
end

local function removeHealthBar(p)
    if p.Character and p.Character:FindFirstChild("BaconHealthBar") then
        p.Character.BaconHealthBar:Destroy()
    end
end

local function applyESP(p, teamCheck)
    if not shouldTargetPlayer(p, teamCheck) then return end
    
    if not p.Character:FindFirstChild("BaconESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "BaconESP"
        hl.FillTransparency = 1
        hl.OutlineTransparency = 0
        hl.OutlineColor = Color3.fromRGB(135,206,235)
        hl.Adornee = p.Character
        hl.Parent = p.Character
    end
    
    if settings.HealthDisplay then
        createHealthBar(p)
    end
end

local function resetESP(p)
    if p.Character and p.Character:FindFirstChild("BaconESP") then
        p.Character.BaconESP:Destroy()
    end
    removeHealthBar(p)
end

-- Monitor team changes cho từng player
local function setupTeamMonitor(p)
    if p == player then return end
    
    p:GetPropertyChangedSignal("Team"):Connect(function()
        local newTeam = p.Team
        local oldTeam = playerTeams[p.UserId]
        
        if newTeam ~= oldTeam then
            playerTeams[p.UserId] = newTeam
            
            -- Update hitbox ngay lập tức
            if settings.HitboxTeam then
                if shouldTargetPlayer(p, true) then
                    applyHitboxReal(p, true)
                else
                    resetHitboxReal(p)
                end
            end
            
            -- Update ESP ngay lập tức
            if settings.ESPTeam then
                if shouldTargetPlayer(p, true) then
                    applyESP(p, true)
                else
                    resetESP(p)
                end
            end
        end
    end)
end

-- Setup team monitor cho tất cả player hiện tại
for _, p in pairs(game.Players:GetPlayers()) do
    if p ~= player then
        playerTeams[p.UserId] = p.Team
        setupTeamMonitor(p)
    end
end

-- Track player join
game.Players.PlayerAdded:Connect(function(p)
    playerTeams[p.UserId] = p.Team
    setupTeamMonitor(p)
end)

-- Track player leave
game.Players.PlayerRemoving:Connect(function(p)
    playerHitboxes[p.UserId] = nil
    playerTeams[p.UserId] = nil
end)

