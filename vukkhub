-- Logic Quét Đồng Thời
local function MasterScanner()
    local detects = { Auto = false, Spawn = false, UI = false, Random = false, Balanced = false, Gated = false, Attr = false, Tag = false, Money = false }
    for _, t in pairs(teams:GetTeams()) do
        if t.AutoAssignable then detects.Auto = true end
        if string.find(string.lower(t.Name), "vip") or string.find(string.lower(t.Name), "pass") then detects.Money = true end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and obj.AllowTeamChangeOnTouch then detects.Spawn = true break end
    end
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        for _, gui in pairs(pGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local n = string.lower(gui.Name)
                if string.find(n, "team") or string.find(n, "choose") then detects.UI = true break end
            end
        end
    end
    for _, p in pairs(players:GetPlayers()) do
        if p:GetAttribute("Team") or p:GetAttribute("Role") then detects.Attr = true end
        if p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild("Level") then detects.Gated = true end
    end
    
    for key, state in pairs(detects) do
        local labelData = teamLabels[key]
        if labelData then
            if state then labelData.obj.Text = "• " .. labelData.text .. ": Yes" labelData.obj.TextColor3 = Color3.fromRGB(135, 206, 250)
            else labelData.obj.Text = "• " .. labelData.text .. ": ❌ No" labelData.obj.TextColor3 = Color3.fromRGB(180, 180, 180) end
        end
    end

    local antis = { Adonis = false, Valkyrie = false, Memory = false, Humanoid = false, Remote = false, Byfron = true }
    for _, item in pairs(game:GetDescendants()) do
        if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
            local name = string.lower(item.Name)
            if string.find(name, "adonis") then antis.Adonis = true end
            if string.find(name, "vanguard") or string.find(name, "ac") then antis.Valkyrie = true end
        end
    end
    
    for key, state in pairs(antis) do
        local labelData = antiLabels[key]
        if labelData then
            if state then labelData.obj.Text = "• " .. labelData.text .. ": ⚠️ Yes (Found)" labelData.obj.TextColor3 = Color3.fromRGB(255, 75, 75)
            else labelData.obj.Text = "• " .. labelData.text .. ": Safe" labelData.obj.TextColor3 = Color3.fromRGB(150, 200, 150) end
        end
    end
end

